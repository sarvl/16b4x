;this test ensures that UI works properly - must not interact with registers

	mov 	R3, 0x00

	xwr 	UI, 0x11
	mov 	R0, 0x11

	xwr 	UI, 0x22
	mov 	R1, 0x22

	mwr 	R3, R0

	xwr 	UI, 0x10
	mwr 	R3, R1

; also check whether UI overwrites regular register use (should not)

	mrd 	R7, 0x00
	xwr 	UI, 0x10
	mrd 	R6, 0x00

	hlt
